+        // with the model's own id normalised, so only byte-identical output is shared.
+        Map<String, String> animationOwners = new HashMap<>();
+        Map<String, String> geometryOwners = new HashMap<>();
+        List<String> animationIds = new ArrayList<>(animationCache.keySet());
+        Collections.sort(animationIds);
+
+        for (String animationId : animationIds) {
+            Map.Entry<String, Animation> entry = Map.entry(animationId, animationCache.get(animationId));
             Entity entity = entityCache.get(entry.getKey());
             Geometry geo = geometryCache.get(entry.getKey());
 
@@ -135,6 +144,15 @@ public class ResourcePackManager {
             boolean hasControllers = controller.getJson().has("animation_controllers")
                     && !controller.getJson().getAsJsonObject("animation_controllers").entrySet().isEmpty();
 
+            String key = GSON.toJson(animationsJson).replace("animation." + entry.getKey() + ".", "animation.@.")
+                    + "|" + controller.getJson().toString().replace("controller.animation." + entry.getKey() + ".", "controller.animation.@.")
+                    + "|" + entry.getValue().getPath();
+            String owner = animationOwners.putIfAbsent(key, entry.getKey());
+            if (owner != null) {
+                if (entity != null) entity.setAnimationOwner(owner);
+                continue;
+            }
+
             try {
                 if (hasAnimations && !path.toFile().exists()) {
                     Files.writeString(path, GSON.toJson(animationsJson), StandardCharsets.UTF_8);
@@ -188,6 +206,16 @@ public class ResourcePackManager {
                 }
             }
 
+            if (entity != null && entity.getModelConfig().getPerTextureUvSize().isEmpty() && !(entity.hasTints())) {
+                String id = entry.getValue().getInternal().get("description").getAsJsonObject().get("identifier").getAsString();
+                String key = GSON.toJson(entry.getValue().getJson()).replace("\"" + id + "\"", "\"@\"") + "|" + entry.getValue().getPath();
+                String owner = geometryOwners.putIfAbsent(key, id);
+                if (owner != null) {
